{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lume",
  "version": "0.1.4",
  "identifier": "local.lume.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lume",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 680,
        "backgroundColor": "#141414"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Aguiiiar",
    "homepage": "https://github.com/Aguiiiar/lume",
    "category": "Entertainment",
    "shortDescription": "Sua biblioteca pessoal de filmes, séries e animes",
    "longDescription": "Catálogo local com player nativo, seleção de áudio, legendas e retomada por episódio.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY.md": "THIRD_PARTY.md",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MkQ4OTY0MTJFNTEwQzkKUldUSkVPVVNaSWt0cGxmNFpMSm44dlBVbHBCV0RDaE9RVk81cXY4RWp5b0RtQmVaU0tucGlHSlEK",
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
